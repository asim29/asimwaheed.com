# script-src carries the SHA-256 of the single inline theme script rather than
# 'unsafe-inline', so only that exact script may run. The hash covers its bytes
# verbatim: editing src/constants/theme.ts invalidates it. tests/build/theme.test.ts
# recomputes the hash from the built HTML and fails with the replacement value.

/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; script-src 'sha256-XgzbI+tnJ+P+//vB8miGC6BPKORT0ik41a0f8ozjoBU='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
