{
  "name": "asimwaheed.com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.css'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "markdownlint": "markdownlint '**/*.md' --ignore-path .gitignore",
    "markdownlint:fix": "markdownlint --fix '**/*.md' --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run markdownlint && pnpm run check && pnpm run build && pnpm run test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "html-validate": "^11.9.0",
    "husky": "^9.1.7",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-external-links": "^3.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,astro,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
