{
  "name": "asimwaheed.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.css'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "markdownlint": "markdownlint '**/*.md' --ignore-path .gitignore",
    "markdownlint:fix": "markdownlint --fix '**/*.md' --ignore-path .gitignore",
    "ci": "npm run lint && npm run format:check && npm run markdownlint && npm run check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^5.16.6",
    "remark-external-links": "^9.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  },
  "lint-staged": {
    "*.{ts,astro,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
