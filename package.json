{
  "name": "asimwaheed.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.css'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "markdownlint": "markdownlint '**/*.md' --ignore-path .gitignore",
    "markdownlint:fix": "markdownlint --fix '**/*.md' --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run format:check && npm run markdownlint && npm run check && npm run build && npm run test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "html-validate": "^11.5.3",
    "husky": "^9.1.7",
    "linkedom": "^0.18.12",
    "lint-staged": "^17.0.8",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-external-links": "^3.0.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "overrides": {
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{ts,astro,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
