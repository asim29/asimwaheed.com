---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeContent from "../content/home.md";
import asimPhoto from "../assets/AsimPhoto.jpg";
import "./_index.css";
---

<BaseLayout description="Research, writing, and work in progress.">
  <div class="intro">
    <Image
      src={asimPhoto}
      alt="Portrait of Asim Waheed"
      width={220}
      height={220}
      class="intro-photo"
    />

    <div class="intro-text">
      <HomeContent />
    </div>
  </div>
</BaseLayout>
