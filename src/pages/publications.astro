---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../constants/site";
import { groupByKind } from "../lib/publications";

import "./_publications.css";

const publications = await getCollection("publications");

// newest → oldest
publications.sort((a, b) => b.data.year - a.data.year);

const groups = groupByKind(publications);
---

<BaseLayout title="Publications" description="Research publications">
  {
    groups.map(({ heading, entries }) => (
      <section class="publication-group">
        <h2 class="publication-group-heading">{heading}</h2>

        {entries.map(({ data }) => {
          const links = data.links ? Object.entries(data.links) : [];

          return (
            <article class="publication">
              <h3 class="publication-title">{data.title}</h3>

              <p class="publication-meta">
                {data.authors.map((author, i) => (
                  <>
                    {author === SITE.name ? <strong>{author}</strong> : author}
                    {i < data.authors.length - 1 && ", "}
                  </>
                ))}
                <br />
                <small>
                  {data.venue} · {data.year}
                </small>
              </p>

              {links.length > 0 && (
                <p class="publication-links">
                  {links.map(([label, url], i) => (
                    <>
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {label}
                      </a>
                      {i < links.length - 1 && " · "}
                    </>
                  ))}
                </p>
              )}
            </article>
          );
        })}
      </section>
    ))
  }
</BaseLayout>
