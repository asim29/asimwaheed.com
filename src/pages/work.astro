---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byEndDescending } from "../lib/timeline";
import "./_work.css";

const allEntries = await getCollection("work");

const introEntry = allEntries.find((e) => e.data.kind === "intro");
const otherEntry = allEntries.find((e) => e.data.kind === "other");

const sortedTimeline = allEntries
  .filter((e) => e.data.kind === "timeline")
  .sort(byEndDescending);

const IntroContent = introEntry ? (await render(introEntry)).Content : null;
const OtherContent = otherEntry ? (await render(otherEntry)).Content : null;

const timelineItems = await Promise.all(
  sortedTimeline.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  }))
);
---

<BaseLayout title="Work" description="Background and trajectory">
  {
    IntroContent && (
      <section class="work-intro">
        <IntroContent />
      </section>
    )
  }

  <section class="timeline">
    {
      timelineItems.map(({ data, Content }) => (
        <div class="timeline-item">
          <div class="timeline-marker" />

          <div class="timeline-content">
            <div class="timeline-dates">
              {data.start} – {data.end}
            </div>

            <Content />
          </div>
        </div>
      ))
    }
  </section>

  {
    OtherContent && otherEntry && (
      <section class="work-other">
        <h3>{otherEntry.data.title}</h3>
        <OtherContent />
      </section>
    )
  }
</BaseLayout>
