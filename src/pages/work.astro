---
import BaseLayout from "../layouts/BaseLayout.astro";
import "./_work.css"

// Load all about content
const allEntries = await Astro.glob("../content/about/*.md");

// Extract intro
const introEntry = allEntries.find(
  (e) => e.frontmatter.kind === "intro"
);

// Extract timeline entries
const timelineEntries = allEntries.filter(
  (e) => e.frontmatter.kind !== "intro"
);

// Sort timeline: newest → oldest
const sortedEntries = timelineEntries.sort((a, b) => {
  const aEnd = a.frontmatter.end === "present" ? Infinity : a.frontmatter.end;
  const bEnd = b.frontmatter.end === "present" ? Infinity : b.frontmatter.end;
  return bEnd - aEnd;
});
---

<BaseLayout title="About" description="Background and trajectory">
  {introEntry && (
    <section class="about-intro">
      <introEntry.Content />
    </section>
  )}

  <section class="timeline">
    {sortedEntries.map((Entry) => (
      <div class="timeline-item">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <div class="timeline-dates">
            {Entry.frontmatter.start} – {Entry.frontmatter.end}
          </div>

          <Entry.Content />
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
