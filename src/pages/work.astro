---
import type { MarkdownInstance } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "./_work.css";

// Give the markdown a type so TS knows about frontmatter + Content
type WorkFrontmatter = {
  kind: "intro" | "other" | "timeline";
  start?: number;
  end?: number | "present";
  title?: string;
};

const allEntries = Object.values(
  import.meta.glob<MarkdownInstance<WorkFrontmatter>>(
    "../content/work/*.md",
    { eager: true }
  )
);

const introEntry = allEntries.find((e) => e.frontmatter.kind === "intro");
const otherEntry = allEntries.find((e) => e.frontmatter.kind === "other");

const timelineEntries = allEntries.filter(
  (e) => e.frontmatter.kind !== "intro" && e.frontmatter.kind !== "other"
);

const sortedEntries = timelineEntries.sort((a, b) => {
  const aEnd = a.frontmatter.end === "present" ? Infinity : (a.frontmatter.end ?? -Infinity);
  const bEnd = b.frontmatter.end === "present" ? Infinity : (b.frontmatter.end ?? -Infinity);
  return Number(bEnd) - Number(aEnd);
});
---

<BaseLayout title="Work" description="Background and trajectory">
  {introEntry && (
    <section class="work-intro">
      <introEntry.Content />
    </section>
  )}

  <section class="timeline">
    {sortedEntries.map((Entry) => (
      <div class="timeline-item">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <div class="timeline-dates">
            {Entry.frontmatter.start} – {Entry.frontmatter.end}
          </div>

          <Entry.Content />
        </div>
      </div>
    ))}
  </section>

  {otherEntry && (
    <section class="work-other">
      <h3>{otherEntry.frontmatter.title}</h3>
      <otherEntry.Content />
    </section>
  )}
</BaseLayout>
