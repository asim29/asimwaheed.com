---
import "../styles/main.css";
import { Font } from "astro:assets";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import asimPhoto from "../assets/AsimPhoto.jpg";
import { SITE } from "../constants/site";
import { THEME_COLORS, THEME_INIT_SCRIPT } from "../constants/theme";

interface Props {
  title?: string;
  description?: string;
  // Markdown pages (layout: frontmatter key) pass their frontmatter here
  // instead of as top-level props.
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? SITE.name;
const description =
  Astro.props.description ??
  frontmatter?.description ??
  "Personal site of Asim Waheed.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(asimPhoto.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    {
      /* First script in the document so a stored theme is applied before the
        first paint. `is:inline` keeps it verbatim rather than bundling it to a
        separate request, which is both what the CSP hash is computed over and
        what makes it synchronous. */
    }
    <script is:inline set:html={THEME_INIT_SCRIPT} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      /* Browser and OS chrome follow the OS preference rather than an explicit
        toggle choice: a media-scoped meta cannot read data-theme, and syncing it
        would mean growing the inline script for a cosmetic address-bar tint. */
    }
    <meta
      name="theme-color"
      content={THEME_COLORS.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={THEME_COLORS.dark}
      media="(prefers-color-scheme: dark)"
    />

    {
      /* Only the body face is preloaded. Preloading competes with other critical
        resources, and headings can swap without shifting the reading column. */
    }
    <Font cssVariable="--font-brand-serif" preload />
    <Font cssVariable="--font-brand-sans" />
    <Font cssVariable="--font-brand-mono" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <main class="container">
      <div class="content">
        <Masthead />

        {
          /* The masthead name looks like a page title but is a link, so without
            this every page ships with no h1 at all. It is hidden because no page
            displays its own title, and it reuses `title` so the outline and the
            <title> tag can never drift apart. */
        }
        <h1 class="sr-only">{title}</h1>

        <slot />

        <Footer />
      </div>
    </main>
  </body>
</html>
