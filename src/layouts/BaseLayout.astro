---
import "../styles/main.css";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import asimPhoto from "../assets/AsimPhoto.jpg";
import { SITE } from "../constants/site";

interface Props {
  title?: string;
  description?: string;
  // Markdown pages (layout: frontmatter key) pass their frontmatter here
  // instead of as top-level props.
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? SITE.name;
const description =
  Astro.props.description ??
  frontmatter?.description ??
  "Personal site of Asim Waheed.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(asimPhoto.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <main class="container">
      <div class="content">
        <Masthead />

        <slot />

        <Footer />
      </div>
    </main>
  </body>
</html>
