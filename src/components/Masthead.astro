---
import "./Masthead.css";

import IconLink from "./IconLink.astro";

import MailIcon from "../icons/mail.svg";
import GitHubIcon from "../icons/github.svg";
import LinkedInIcon from "../icons/linkedin.svg";
import ScholarIcon from "../icons/graduation-cap.svg";

import { CONTACT_ARIA_LABELS } from "../constants/aria";
import { SITE } from "../constants/site";
---

<header class="masthead">
  <!-- Row 1: Identity + Icons -->
  <div class="masthead-top">
    <div class="masthead-left">
      <a href={SITE.homeHref} class="masthead-name">
        {SITE.name}
      </a>
    </div>

    <div class="masthead-right">
      <IconLink
        href={`mailto:${SITE.email}`}
        ariaLabel={CONTACT_ARIA_LABELS.email}
        icon={MailIcon}
        external={false}
      />

      <IconLink
        href={SITE.github}
        ariaLabel={CONTACT_ARIA_LABELS.github}
        icon={GitHubIcon}
      />

      <IconLink
        href={SITE.scholar}
        ariaLabel={CONTACT_ARIA_LABELS.scholar}
        icon={ScholarIcon}
      />

      <IconLink
        href={SITE.linkedin}
        ariaLabel={CONTACT_ARIA_LABELS.linkedin}
        icon={LinkedInIcon}
      />
    </div>
  </div>

  <!-- Row 2: Navigation -->
  <nav class="masthead-nav" aria-label="Primary">
    <a href="/" class="nav-link">Home</a>
    <a href="/work" class="nav-link">Work</a>
    <a href="/publications" class="nav-link">Publications</a>
    <a href="/collaborate" class="nav-link">Collaborate</a>
  </nav>
</header>
