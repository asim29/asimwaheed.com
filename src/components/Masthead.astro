---
import "./Masthead.css";

import IconLink from "./IconLink.astro";

import MailIcon from "../icons/mail.svg";
import GitHubIcon from "../icons/github.svg";
import LinkedInIcon from "../icons/linkedin.svg";
import ScholarIcon from "../icons/graduation-cap.svg";

import { CONTACT_ARIA_LABELS } from "../constants/aria";
import { SITE } from "../constants/site";

const pathname = Astro.url.pathname.replace(/\/$/, "");
---

<header class="masthead">
  <!-- Row 1: Identity + Icons -->
  <div class="masthead-top">
    <div class="masthead-left">
      <a href={SITE.homeHref} class="masthead-name">
        {SITE.name}
      </a>
    </div>

    <div class="masthead-right">
      <span class="email-icon">
        <IconLink
          href={`mailto:${SITE.email}`}
          ariaLabel={CONTACT_ARIA_LABELS.email}
          icon={MailIcon}
          external={false}
        />
      </span>

      <IconLink
        href={SITE.github}
        ariaLabel={CONTACT_ARIA_LABELS.github}
        icon={GitHubIcon}
      />
      <IconLink
        href={SITE.scholar}
        ariaLabel={CONTACT_ARIA_LABELS.scholar}
        icon={ScholarIcon}
      />
      <IconLink
        href={SITE.linkedin}
        ariaLabel={CONTACT_ARIA_LABELS.linkedin}
        icon={LinkedInIcon}
      />
    </div>
  </div>

  <!-- Desktop nav -->
  <nav class="masthead-nav" aria-label="Primary">
    <a href="/" class={`nav-link ${pathname === "" ? "active" : ""}`}>Home</a>
    <a href="/work" class={`nav-link ${pathname === "/work" ? "active" : ""}`}
      >Work</a
    >
    <a
      href="/publications"
      class={`nav-link ${pathname === "/publications" ? "active" : ""}`}
      >Publications</a
    >
    <a
      href="/collaborate"
      class={`nav-link ${pathname === "/collaborate" ? "active" : ""}`}
      >Collaborate</a
    >
  </nav>

  <!-- Mobile menu -->
  <div class="masthead-menu">
    <details class="menu-details">
      <summary class="menu-summary">
        <span class="menu-label">Menu</span>
        <span class="menu-close">×</span>
      </summary>

      <nav class="menu-panel" aria-label="Mobile primary">
        <a href="/" class={`nav-link ${pathname === "" ? "active" : ""}`}
          >Home</a
        >
        <a
          href="/work"
          class={`nav-link ${pathname === "/work" ? "active" : ""}`}>Work</a
        >
        <a
          href="/publications"
          class={`nav-link ${pathname === "/publications" ? "active" : ""}`}
          >Publications</a
        >
        <a
          href="/collaborate"
          class={`nav-link ${pathname === "/collaborate" ? "active" : ""}`}
          >Collaborate</a
        >
        <div class="menu-contact">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </nav>
    </details>
  </div>
</header>
