---
import { ICON_SIZE } from "../constants/layout";

const {
  href,
  ariaLabel,
  icon: Icon,
  size = ICON_SIZE,
  external = true,
} = Astro.props;

import "./IconLink.css";

if (!ariaLabel) {
  throw new Error("IconLink requires an ariaLabel prop");
}
---

<a
  href={href}
  aria-label={ariaLabel}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  class="icon-link"
>
  <Icon width={size} height={size} />
</a>
